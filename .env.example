# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Zoho Configuration
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_BOOKS_CLIENT_ID=your_zoho_books_client_id
ZOHO_BOOKS_CLIENT_SECRET=your_zoho_books_client_secret
ZOHO_BOOKS_REFRESH_TOKEN=your_zoho_books_refresh_token
ZOHO_BOOKS_ORGANIZATION_ID=123456789
ZOHO_AUTH_DOMAIN=https://accounts.zoho.com

# Inventory queue worker
CRON_SECRET=replace_with_a_long_random_secret
INVENTORY_SYNC_BATCH_SIZE=30
INVENTORY_SYNC_MAX_PENDING_AGE_MINUTES=15

# OpenAI Configuration
# API Key para GPT-4o (Vision) - Módulo de pruebas de imágenes y URLs
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Groq Configuration (si se usa)
GROQ_API_KEY=your_groq_api_key
